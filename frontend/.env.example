# Configurable Backend URL for frontend deployment
# Set these when hosting the backend on a separate domain (e.g. Render, Railway, AWS, Heroku)

# HTTP API Base URL (leave empty if using Vite dev proxy or single-domain hosting)
VITE_API_BASE_URL=

# WebSocket Base URL (e.g. wss://your-backend-api.com)
VITE_WS_BASE_URL=
