# Server Database URL (Railway will provide this automatically)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/support_chat

# JWT Settings
JWT_SECRET=production_jwt_signing_key_replace_this
JWT_ALGORITHM=HS256

# Initial Admin Seeding Credentials (created on startup if DB is empty)
FIRST_SUPERUSER_EMAIL=admin@support.com
FIRST_SUPERUSER_PASSWORD=AdminPassword123
